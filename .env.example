# WorkFlow Pro assessment environment
WORKFLOWPRO_API_BASE_URL=https://app.workflowpro.com/api/v1
WORKFLOWPRO_COMPANY1_WEB_URL=https://company1.workflowpro.com
WORKFLOWPRO_COMPANY2_WEB_URL=https://company2.workflowpro.com
WORKFLOWPRO_COMPANY1_ID=company1
WORKFLOWPRO_COMPANY2_ID=company2

# Test users - use dedicated non-production accounts only
WORKFLOWPRO_COMPANY1_ADMIN_EMAIL=admin@company1.com
WORKFLOWPRO_COMPANY1_ADMIN_PASSWORD=CHANGE_ME
WORKFLOWPRO_COMPANY1_ADMIN_TOTP=
WORKFLOWPRO_COMPANY2_USER_EMAIL=user@company2.com
WORKFLOWPRO_COMPANY2_USER_PASSWORD=CHANGE_ME
WORKFLOWPRO_COMPANY2_USER_TOTP=

# API tokens - never commit real values
WORKFLOWPRO_COMPANY1_TOKEN=
WORKFLOWPRO_COMPANY2_TOKEN=

# Test execution
WORKFLOWPRO_UI_TIMEOUT_MS=15000
WORKFLOWPRO_API_TIMEOUT_SECONDS=15
RUN_LIVE_E2E=false

# BrowserStack - configure in CI secrets or local environment
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
